# Installed by scripts/setup_linux.sh as /etc/systemd/system/comfy@.service (paths and user substituted).
# One ComfyUI instance per GPU: systemctl enable --now comfy@0 comfy@1 ...   (instance N listens on 8188+N)
[Unit]
Description=ComfyUI instance %i (GPU %i, port 8188+%i)
After=network.target

[Service]
User=__USER__
WorkingDirectory=__REPO__
ExecStart=/usr/bin/env bash __REPO__/scripts/comfy_instance.sh %i __COMFY_ROOT__
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
